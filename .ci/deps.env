# Pinned versions of the native libraries bundled into the Linux wheels.
#
# Keep this file as the single place these are declared, so a dependency bump is a one-line
# change here and the build records the values into ${PREFIX}/bundled-versions.env.
#
# Bumping a version here changes no module code, but publishing the rebuilt wheels still needs
# __version__ raised in src/bonsai/__init__.py, since PyPI refuses a second upload under a
# filename it already has. A post-release (e.g. 1.5.5.post1) is enough.
#
# Track OpenSSL's LTS line rather than the newest release: 3.5 is supported until 2030-04-08,
# where 3.6 reaches EOL in 2026-11 and 4.0 in 2027-05.
#
# docs/install.rst includes this file from the first assignment to the end of it, so keep the
# assignments together and last.
OPENSSL_VERSION=3.5.8
CYRUS_SASL_VERSION=2.1.28
OPENLDAP_VERSION=2.6.10
KRB5_VERSION=1.22.2
