from collections.abc import Iterator
from typing import Any, Literal, Awaitable, overload

from bonsai.ldapdn import LDAPDN
from bonsai.ldapvaluelist import LDAPValueList
from bonsai.ldapconnection import BaseLDAPConnection
from bonsai.ldapclient import LDAPClient
from bonsai.ldapentry import LDAPEntry

__all__ = [
    "ldapconnection",
    "ldapentry",
    "ldapsearchiter",
    "get_tls_impl_name",
    "set_connect_async",
    "get_vendor_info",
    "set_debug",
    "is_bundled",
    "_unique_contains",
]

class ldapconnection:
    def __init__(self, client: LDAPClient, is_async: bool) -> None: ...
    @property
    def is_async(self) -> bool: ...
    @property
    def closed(self) -> bool: ...
    def abandon(self, msgid: int, /) -> None: ...
    def add(self, entry: LDAPEntry, /) -> int: ...
    def close(self, abandon_requests: bool = False) -> None: ...
    def delete(self, dname: str, recursive: bool = ..., /) -> int: ...
    def fileno(self) -> int: ...
    def get_result(self, msgid: int, timeout: float | None = None) -> Any: ...
    def open(self) -> int: ...
    def modify_password(
        self,
        user: str | bytes | None = ...,
        new_password: str | bytes | None = ...,
        old_password: str | bytes | None = ...,
    ) -> int: ...
    def _wants_write(self, msgid: int, /) -> bool: ...
    def search(
        self,
        base: str | None = None,
        scope: int = 0,
        filter: str | None = None,
        attrlist: list[str] | None = None,
        timeout: float = 0.0,
        sizelimit: int = 0,
        attrsonly: bool = False,
        sort_order: list[tuple[str, bool]] | None = None,
        page_size: int = 0,
        offset: int = 0,
        before_count: int = 0,
        after_count: int = 0,
        est_list_count: int = 0,
        attrvalue: str | bytes | None = ...,
    ) -> int: ...
    def whoami(self) -> int: ...

class ldapentry(dict[str, LDAPDN | LDAPValueList]):
    def __init__(
        self, dn: LDAPDN | str, conn: BaseLDAPConnection | None = None
    ) -> None: ...
    @property
    def connection(self) -> BaseLDAPConnection: ...
    @connection.setter
    def connection(self, value: BaseLDAPConnection) -> None: ...
    @property
    def dn(self) -> LDAPDN: ...
    @dn.setter
    def dn(self, value: LDAPDN | str) -> None: ...
    @property
    def deleted_keys(self) -> list[str]: ...
    def __contains__(self, key: object) -> bool: ...
    @overload
    def __getitem__(  # type: ignore[overload-overlap]
        self, key: Literal["dn", "DN", "Dn", "dN"]
    ) -> LDAPDN: ...
    @overload
    def __getitem__(self, key: object) -> LDAPValueList: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def __setitem__(self, key: object, value: Any) -> None: ...
    def __delitem__(self, key: object) -> None: ...
    def modify(self) -> int: ...
    def rename(self, newdn: LDAPDN | str, delete_old_rdn: bool) -> int: ...

class ldapsearchiter:
    @property
    def timeout(self) -> float | None: ...
    def acquire_next_page(self) -> int | None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> "ldapsearchiter": ...
    def __next__(self) -> LDAPEntry: ...
    def __aiter__(self) -> "ldapsearchiter": ...
    def __anext__(self) -> Awaitable[LDAPEntry]: ...

def get_tls_impl_name() -> str: ...
def set_connect_async(value: bool) -> None: ...
def get_vendor_info() -> tuple[str, int]: ...
def has_krb5_support() -> bool: ...
def _unique_contains(list: LDAPValueList, value: Any) -> tuple[bool, Any]: ...
def set_debug(value: bool, level: int = 0) -> None: ...
def is_bundled() -> bool: ...
